# Spring Application Info
spring.application.name=logs-service
server.port=8084

# MySQL Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/platform-db?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Consul Configuration
spring.cloud.consul.discovery.prefer-ip-address=true

# Optional Config Server
spring.config.import=optional:configserver:http://localhost:8999/

# Kafka Configuration
spring.kafka.bootstrap-servers=localhost:9099

# Kafka Producer Configuration
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

# Kafka Consumer Configuration
spring.kafka.consumer.group-id=logs_group
spring.kafka.consumer.auto-offset-reset=earliest
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.springframework.kafka.support.serializer.JsonDeserializer

# Kafka JSON Deserialization
spring.kafka.consumer.properties.spring.json.trusted.packages=org.sid.logs_service.models
spring.kafka.consumer.properties.spring.json.value.default.type=org.sid.logs_service.models.LogEntry
spring.kafka.consumer.properties.spring.json.type.mapping=logEntry:org.sid.logs_service.models.LogEntry

# Kafka Listener Settings (Optional)
# Increase concurrency if you want to process multiple partitions simultaneously
spring.kafka.listener.concurrency=3

# Additional Logging Settings (Optional)
logging.level.org.springframework.kafka=INFO
logging.level.org.apache.kafka=INFO
